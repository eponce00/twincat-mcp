{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TcAutomation - Build",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build-tcautomation",
      "program": "${workspaceFolder}/TcAutomation/bin/Release-v2/TcAutomation.exe",
      "args": [
        "build",
        "--solution",
        "${input:solutionPath}"
      ],
      "cwd": "${workspaceFolder}/TcAutomation",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "TcAutomation - Info",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build-tcautomation",
      "program": "${workspaceFolder}/TcAutomation/bin/Release-v2/TcAutomation.exe",
      "args": [
        "info",
        "--solution",
        "${input:solutionPath}"
      ],
      "cwd": "${workspaceFolder}/TcAutomation",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Python: MCP Server (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mcp-server/server.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    }
  ],
  "inputs": [
    {
      "id": "solutionPath",
      "type": "promptString",
      "description": "Path to TwinCAT solution file (.sln)"
    }
  ]
}
